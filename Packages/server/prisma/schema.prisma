// -----------------------------------------------------------------------------
// PRISMA CONFIGURATION
// -----------------------------------------------------------------------------


generator client {
  provider = "prisma-client-js"
  engineType = "library"
  // Tell Prisma to put the client right here in the prisma folder!
  output     = "../node_modules/@generated/prisma-client"
}

datasource db {
  provider = "postgresql"
}




// -----------------------------------------
// Enums: Join Request Status
// -----------------------------------------

// --- ENUMS ---
enum JoinRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

// Controls feed visibility
enum IdeaStatus {
  OPEN      // Visible in feed, accepting requests
  FILLED    // Hidden from feed, max members reached
  CLOSED    // Manually closed by owner
}


// -----------------------------------------------------------------------------
// CORE USER & IDENTITY
// Handles Auth, Profile (Social & Pro), and Leaderboard Stats
// -----------------------------------------------------------------------------
// This is user model that stores all entities related to user 
// these entities are shared among different features of the application


model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String

  // --- IDENTITY & PREFERENCES (Step 1 of registration form) ---
  name          String?
  avatar        String?   // URL for small thumbnails
  dob           DateTime? //age (static) changed to dateofbirth (dynamic)
  university    String?
  discipline    String?   // Renamed from 'major' to match frontend
  expectedGraduationYear String?

  // Matching Preferences
  matchWithDisciplines String[] // Postgres String Array
  matchWithYears       String[]


  // --- PROFESSIONAL PROFILE (Step 2 of registration form) ---
  profilePicture  String?   // Merged avatar/image into one main professional headshot URL
  skills          String[]
  industriesOfInterest String[]
  professionalGoals    String[]
  linkedin        String?
  github          String?
  portfolioWebsite String?


  // --- SOCIAL PROFILE (Step 3 of registration form) ---
  socialPictures  String[]  // Array of URLs for the max 3 social photos
  bio             String?
  hobbies         String[]  // Replaces the generic 'interests'
  campusInvolvement String[]
  personalityType String?
  socialGoals     String[]
  lookingFor      String[]

  // Gamification (Mapped from Interface 6 - Leaderboard)
  // these are not static array, rather it will be dynamically calculated in the backend and added to database
  xp            Int       @default(0)
  badge         String    @default("Rising")
  
  // Relationships: Professional
  ownedProjects    Project[]         @relation("ProjectOwner")
  projectMemberships ProjectMember[] @relation("UserMemberships") // NEW: Replaces direct project link
  projectIdeas     ProjectIdea[]
  ideaWishes       ProjectIdeaWish[] // NEW: Tracks which ideas the user wished for
  posts            Post[]            // Questions & Discussions
  comments         Comment[]         // Replies
  sentMessages     Message[]         @relation("SentMessages")

  // --- UPDATED: Our new Scalable Discussion Architecture ---
  discussions        Discussion[]        // A user can author many discussions
  discussionReplies  DiscussionReply[]   // A user can author many replies

  // Relationships: Social
  scheduleEntries  ScheduleEntry[]
  notifications    Notification[]
  
  // Matching relationships
  // Matches are complex; a user can be the "initiator" or the "receiver"
  matchesAsUser1   Match[]           @relation("User1Matches")
  matchesAsUser2   Match[]           @relation("User2Matches")
  
  createdAt     DateTime  @default(now())
  updatedAt       DateTime  @updatedAt // Highly important to track when users update their profiles
}



// -----------------------------------------------------------------------------
// PROFESSIONAL MODE MODELS
// -----------------------------------------------------------------------------

// ==========================================
// 1. CORE PROJECT ARCHITECTURE
// ==========================================
// Project model that stores posted project details

model Project {
  id             String       @id @default(cuid())
  name           String
  description    String

  // Ownership 
  ownerId        String
  owner          User      @relation("ProjectOwner", fields: [ownerId], references: [id])

  // Membership & Join Requests (Explicit Junction Table)
  memberships ProjectMember[]

  //Group Chat
  messages    Message[] @relation("ProjectGroupChat")

  datePosted     DateTime  @default(now())
  
  // Efficiency: Indexes for feed sorting and fast owner lookups
  @@index([ownerId])
  @@index([datePosted(sort: Desc)])
}



// The State Machine for Join Requests & Membership
model ProjectMember {
  id             String   @id @default(cuid())
  projectId      String
  userId         String
  
  // Maintainability: Role and Status management
  role           String   @default("MEMBER")  // e.g., "OWNER", "MEMBER"
  status         String   @default("PENDING") // e.g., "PENDING", "APPROVED", "REJECTED"
  
  // The "Why do you want to join?" answer
  message        String?  @db.Text 
  
  // Scalability: Unread message tracking for group chats
  lastChatReadAt DateTime @default(now()) 
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user           User     @relation("UserMemberships", fields: [userId], references: [id], onDelete: Cascade)

  // A user can only have one active relationship/request per project
  @@unique([projectId, userId])
  
  // Efficiency: Fast lookups for "My Projects" and "Project Roster" queries
  @@index([projectId])
  @@index([userId])
}




// project idea posting feature model

// ==========================================
// 3. PROJECT IDEAS (FEED)
// ==========================================

model ProjectIdea {
  id          String            @id @default(cuid())
  title       String            //store project title
  idea        String            @db.Text
  skills      String[]          // Postgres Array for display/filtering
  wishesCount Int               @default(0) // Cached integer for fast UI reads
  
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Concurrency: Explicit table to track who wished for what
  wishes      ProjectIdeaWish[]
  joinRequests  ProjectJoinRequest[] // Links the requests

  // The Idea connects 1-to-1 with the actual active Project workspace
  project       Project?

  createdAt   DateTime          @default(now())

  // Efficiency: Index for sorting the Ideas feed
  @@index([createdAt(sort: Desc)])
}



// Concurrency fix: Prevents users from wishing multiple times and tracks engagement
model ProjectIdeaWish {
  id            String      @id @default(cuid())
  userId        String
  projectIdeaId String
  createdAt     DateTime    @default(now())

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectIdea   ProjectIdea @relation(fields: [projectIdeaId], references: [id], onDelete: Cascade)

  // A user can only wish for a specific idea once
  @@unique([userId, projectIdeaId])
  @@index([projectIdeaId])
}

// The Project Join Request
model ProjectJoinRequest {
  id             String            @id @default(cuid())
  
  userId         String
  projectIdeaId  String
  
  userMessage    String            @db.Text
  userSkills     String[]          // Immutable snapshot
  status         JoinRequestStatus @default(PENDING)
  
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectIdea    ProjectIdea       @relation(fields: [projectIdeaId], references: [id], onDelete: Cascade)

  // One active/historical request per user per idea
  @@unique([userId, projectIdeaId])
  
  // Fast querying for the "Your Projects" dashboard
  @@index([projectIdeaId, status, createdAt(sort: Desc)])
}




// The Main Discussion Model
model Discussion {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(255) // Caps the title length for UI consistency
  content     String   @db.Text         // Stores the Markdown string. @db.Text allows long content

  // --- NEW: The Image Array ---
  // Stores up to 3 image URLs (e.g., ["/uploads/img1.jpg", "/uploads/img2.jpg"])
  images      String[]

  
  // --- SCALABILITY WIN: Denormalization ---
  // Instead of counting replies dynamically, we store the count here.
  // Our backend will increment this by 1 every time a reply is created.
  replyCount  Int      @default(0)

  // Relations
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  replies     DiscussionReply[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // --- EFFICIENCY WIN: Database Indexes ---
  // These indexes allow the database to fetch "Trending" or "Recent" feeds instantly, 
  // even if you have 10 million discussions.
  @@index([replyCount(sort: Desc)]) // For the "Trending" feed
  @@index([createdAt(sort: Desc)])  // For the "Newest" feed
}


// The Reply Model (Handles Level 1 & Level 2)
model DiscussionReply {
  id             Int      @id @default(autoincrement())
  content        String   @db.Text // Stores the Markdown string

  // Relation to the parent Discussion
  discussionId   Int
  discussion     Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)

  // Relation to Author
  authorId       String
  author         User       @relation(fields: [authorId], references: [id])

  // --- MAINTENANCE WIN: The Two-Level Flat Architecture ---
  // We use a "self-relation" to link replies to other replies.
  // - If parentId is NULL: This is a Level 1 reply (replying to the Discussion).
  // - If parentId has an ID: This is a Level 2 reply (replying to another User).
  parentId       Int?
  parent         DiscussionReply?  @relation("ReplyToReply", fields: [parentId], references: [id], onDelete: Cascade)
  children       DiscussionReply[] @relation("ReplyToReply")

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Indexes to instantly fetch all replies for a specific discussion or parent reply
  @@index([discussionId])
  @@index([parentId])
  @@index([createdAt(sort: Asc)]) // Ensures replies always load in chronological order
}

// questions same model
model Post {
  id        Int       @id @default(autoincrement())
  type      PostType  // To distinguish "questions" from "discussions", It is enum to separate Questions from Discussions
  content   String    @map("question_content") // The main text/question
  useful    Int       @default(0) // "Useful" counter from Interface 4/5
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  replies   Comment[]
  createdAt DateTime  @default(now())
}

// post model type identifiable
enum PostType {
  QUESTION
  DISCUSSION
}


// model comment to store discussion, question answers
model Comment {
  id        Int      @id @default(autoincrement())
  text      String
  postId    Int
  post      Post     @relation(fields: [postId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}



// -----------------------------------------------------------------------------
// SOCIAL MODE MODELS
// -----------------------------------------------------------------------------

// matching model stores essential matching entities
// unique ids are created for user1 and user2 to prevent miss match or rematch for match feature


model Match {
  id            Int       @id @default(autoincrement())
  user1Id       String
  user1         User      @relation("User1Matches", fields: [user1Id], references: [id])
  user2Id       String
  user2         User      @relation("User2Matches", fields: [user2Id], references: [id])
  matchedAt     DateTime  @default(now())
  
  // Chat & Unread logic (Interface 8 & 13)
  messages      Message[] @relation("DirectMatchChat")
  
  @@unique([user1Id, user2Id]) // Prevents duplicate match entries, prevents two match rows for same pair
}

// we run a CORN logic at ScheduleEntry to remove the ScheduleEntry component at expiresAt 
// we use this logic because the ScheduleEntry has a deadline and it expires after certain time when it is posted by user

model ScheduleEntry {
  id          Int      @id @default(autoincrement())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  activity    String
  duration    String
  description String
  location    String
  time        DateTime
  expiresAt   DateTime // Auto-delete reference for Interface 10
  createdAt   DateTime @default(now())
}


// -----------------------------------------------------------------------------
// MESSAGING & NOTIFICATIONS
// Supports both Project Groups and 1-on-1 Social Matches
// -----------------------------------------------------------------------------

// the message model is polymorphic it is used for both the GroupChat in project and the chat among matches
model Message {
  id          String   @id @default(cuid())
  content     String   @db.Text 
  
  senderId    String
  sender      User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  // --- Exclusive Arc: Message belongs to EITHER a Project OR a Match ---
  
  projectId   String?
  project     Project? @relation("ProjectGroupChat", fields: [projectId], references: [id], onDelete: Cascade)

  matchId     Int?
  match    Match?   @relation("DirectMatchChat", fields: [matchId], references: [id], onDelete: Cascade)

  // --- Read State ---
  // ONLY for 1-on-1 Direct Matches. 
  // Project group chats calculate unread state dynamically using ProjectMember.lastChatReadAt
  isMatchRead Boolean  @default(false) 
  
  createdAt   DateTime @default(now())

  // Efficiency: Crucial compound indexes for loading chat history instantly
  @@index([projectId, createdAt(sort: Asc)]) 
  @@index([matchId, createdAt(sort: Asc)])
}

// notificaiton model for whole application 

model Notification {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   // "success", "error", etc. (Interface 14)
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}