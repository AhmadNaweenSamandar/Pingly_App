
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- CORE MODEL & AUTH ---
// This is user model that stores all entities related to user 
// these entities are shared among different features of the application

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  avatar        String?   // URL for avatar
  image         String?   // Background/Profile image for Social mode
  age           Int?
  major         String?
  bio           String?
  interests     String[]
  xp            Int       @default(0)
  badge         String    @default("Rising")
  
  // Relations
  ownedProjects    Project[]         @relation("ProjectOwner")
  memberProjects   Project[]         @relation("ProjectMembers")
  projectIdeas     ProjectIdea[]
  posts            Post[]
  comments         Comment[]
  sentMessages     Message[]
  scheduleEntries  ScheduleEntry[]
  notifications    Notification[]
  
  // Matching relationships
  matchesAsUser1   Match[]           @relation("User1Matches")
  matchesAsUser2   Match[]           @relation("User2Matches")
  
  createdAt     DateTime  @default(now())
}



// --- PROFESSIONAL MODE ---

// Project model that stores posted project details

model Project {
  id             Int       @id @default(autoincrement())
  name           String
  description    String
  ownerId        String
  owner          User      @relation("ProjectOwner", fields: [ownerId], references: [id])
  members        User[]    @relation("ProjectMembers")
  datePosted     DateTime  @default(now())
  
  // For the "unreadMessages" and "group chat" features
  messages       Message[] @relation("ProjectGroupChat")
}

// project idea posting feature model

model ProjectIdea {
  id        Int      @id @default(autoincrement())
  idea      String
  skills    String[]
  wishes    Int      @default(0)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

// questions and discussion are using the same model
model Post {
  id        Int       @id @default(autoincrement())
  type      PostType  // To distinguish "questions" from "discussions"
  content   String    @map("question_content") // Maps to 'question' in your interface
  useful    Int       @default(0)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  replies   Comment[]
  createdAt DateTime  @default(now())
}

// post model type identifiable
enum PostType {
  QUESTION
  DISCUSSION
}


// model comment to store discussion, question answers
model Comment {
  id        Int      @id @default(autoincrement())
  text      String
  postId    Int
  post      Post     @relation(fields: [postId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}